                    <SolidColorBrush x:Key="Text" Color="#EEE5D3" />
                    <SolidColorBrush x:Key="Muted" Color="#A7A08C" />
                    <SolidColorBrush x:Key="Faint" Color="#8F8977" />
                    <SolidColorBrush x:Key="Accent" Color="#D67B66" />
                    <SolidColorBrush x:Key="AccentDeep" Color="#C46A56" />
