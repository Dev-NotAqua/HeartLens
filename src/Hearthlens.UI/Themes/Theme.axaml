<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <!-- ===== Palette: Material 3 dark scheme from an Android-green seed ===== -->
            <Color x:Key="BgColor">#0A0E0B</Color>
            <Color x:Key="SurfaceColor">#111713</Color>
            <Color x:Key="Surface2Color">#171E19</Color>
            <Color x:Key="Surface3Color">#1F2822</Color>
            <Color x:Key="Surface4Color">#28332B</Color>
            <Color x:Key="BorderColor">#222B25</Color>
            <Color x:Key="OutlineColor">#34413A</Color>
            <Color x:Key="TextColor">#E2E9E3</Color>
            <Color x:Key="MutedColor">#A6B3A9</Color>
            <Color x:Key="FaintColor">#6C7A70</Color>
            <Color x:Key="AccentColor">#3DDC84</Color>
            <Color x:Key="AccentDeepColor">#20B266</Color>
            <Color x:Key="AccentContainerColor">#1C4A30</Color>
            <Color x:Key="SecondaryContainerColor">#24382B</Color>
            <Color x:Key="PositiveColor">#4BE08E</Color>
            <Color x:Key="NegativeColor">#FF6E66</Color>
            <Color x:Key="InfoColor">#8FCBFF</Color>

            <!-- Fluent controls (sliders, scroll bars, focus) pick up the app accent. -->
            <Color x:Key="SystemAccentColor">#3DDC84</Color>
            <Color x:Key="SystemAccentColorDark1">#20B266</Color>
            <Color x:Key="SystemAccentColorDark2">#1C8F55</Color>
            <Color x:Key="SystemAccentColorDark3">#1C4A30</Color>
            <Color x:Key="SystemAccentColorLight1">#6BE6A1</Color>
            <Color x:Key="SystemAccentColorLight2">#97EEBE</Color>
            <Color x:Key="SystemAccentColorLight3">#B5F4CB</Color>

            <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
            <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
            <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
            <SolidColorBrush x:Key="Surface4" Color="{StaticResource Surface4Color}" />
            <SolidColorBrush x:Key="Border" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="Outline" Color="{StaticResource OutlineColor}" />
            <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="Muted" Color="{StaticResource MutedColor}" />
            <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
            <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentDeep" Color="{StaticResource AccentDeepColor}" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1F3DDC84" />
            <SolidColorBrush x:Key="AccentLine" Color="#993DDC84" />
            <SolidColorBrush x:Key="AccentContainer" Color="{StaticResource AccentContainerColor}" />
            <SolidColorBrush x:Key="OnAccentContainer" Color="#B5F4CB" />
            <SolidColorBrush x:Key="SecondaryContainer" Color="{StaticResource SecondaryContainerColor}" />
            <SolidColorBrush x:Key="OnSecondaryContainer" Color="#D2EBD9" />
            <SolidColorBrush x:Key="OnAccent" Color="#00210F" />
            <SolidColorBrush x:Key="Positive" Color="{StaticResource PositiveColor}" />
            <SolidColorBrush x:Key="PositiveSoft" Color="#224BE08E" />
            <SolidColorBrush x:Key="Negative" Color="{StaticResource NegativeColor}" />
            <SolidColorBrush x:Key="NegativeSoft" Color="#24FF6E66" />
            <SolidColorBrush x:Key="Info" Color="{StaticResource InfoColor}" />
            <SolidColorBrush x:Key="Hover" Color="#0FE2F5E8" />
            <SolidColorBrush x:Key="Pressed" Color="#1AE2F5E8" />
            <SolidColorBrush x:Key="Decor" Color="#0B3DDC84" />
            <SolidColorBrush x:Key="DecorStrong" Color="#123DDC84" />
            <SolidColorBrush x:Key="OverlayPanel" Color="#EE111713" />
            <SolidColorBrush x:Key="OverlayPanelSolid" Color="#FA111713" />
            <SolidColorBrush x:Key="OverlayBorder" Color="#1CE2F5E8" />
            <SolidColorBrush x:Key="ManaGem" Color="#3D7BE0" />
            <SolidColorBrush x:Key="Row" Color="#1A221C" />
            <SolidColorBrush x:Key="Ink" Color="#0A0E0B" />
            <LinearGradientBrush x:Key="TileFade" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FF1A221C" Offset="0" />
                <GradientStop Color="#FF1A221C" Offset="0.42" />
                <GradientStop Color="#661A221C" Offset="0.8" />
                <GradientStop Color="#141A221C" Offset="1" />
            </LinearGradientBrush>

            <SolidColorBrush x:Key="RarityCommon" Color="#C9D2CB" />
            <SolidColorBrush x:Key="RarityRare" Color="#5B9BFF" />
            <SolidColorBrush x:Key="RarityEpic" Color="#B98AF5" />
            <SolidColorBrush x:Key="RarityLegendary" Color="#FFB547" />

            <SolidColorBrush x:Key="TierS" Color="#FFC857" />
            <SolidColorBrush x:Key="TierA" Color="#3DDC84" />
            <SolidColorBrush x:Key="TierB" Color="#7CC0FF" />
            <SolidColorBrush x:Key="TierC" Color="#A6B3A9" />
            <SolidColorBrush x:Key="TierD" Color="#FF6E66" />

            <!-- ===== Type: Montserrat for display (OFL), the platform UI font for text, Material Design Icons ===== -->
            <!-- UiFont is replaced at startup with the platform's UI font (Segoe UI on Windows, Inter elsewhere). -->
            <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>
            <FontFamily x:Key="DisplayFont">avares://Hearthlens.UI/Assets/Fonts#Montserrat</FontFamily>
            <FontFamily x:Key="IconFont">avares://Hearthlens.UI/Assets/Fonts#Material Design Icons</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Text ===== -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="ExtraBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
    </Style>
    <Style Selector="TextBlock.stat">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.number">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="22,18" />
    </Style>
    <Style Selector="Border.overlayCard">
        <Setter Property="Background" Value="{StaticResource OverlayPanel}" />
        <Setter Property="BorderBrush" Value="{StaticResource OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="9,2" />
    </Style>
    <Style Selector="Border.segmentBar">
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- ===== Buttons (pill shaped) ===== -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}" />
        <Setter Property="Background" Value="{StaticResource SecondaryContainer}" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" CornerRadius="999" />
                    <Border Name="State" Background="Transparent" CornerRadius="999" />
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Border#State">
        <Setter Property="Background" Value="{StaticResource Pressed}" />
    </Style>
    <Style Selector="Button.ghost:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.icon">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="999">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Surface4}" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>

    <!-- A button with no chrome: the content draws everything (overlay chips, rows). -->
    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===== Navigation: pill indicator behind the active item ===== -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="Bd" CornerRadius="999" Margin="10,2" Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Name="Glyph" Classes="icon" Text="{TemplateBinding Tag}" FontSize="20" Width="24"
                                       Foreground="{TemplateBinding Foreground}" />
                            <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SecondaryContainer}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ TextBlock#Glyph">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}" />
    </Style>

    <!-- ===== Chips / segmented filter ===== -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="999" Padding="13,6" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="Check" Classes="icon" Text="&#xF012C;" FontSize="14" Margin="0,0,5,0"
                                   Foreground="{StaticResource OnSecondaryContainer}" IsVisible="False" />
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SecondaryContainer}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ TextBlock#Check">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{StaticResource OnSecondaryContainer}" />
    </Style>

    <!-- ===== Material 3 switch ===== -->
    <Style Selector="CheckBox.switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Name="Track" Grid.Column="1" Width="48" Height="28" CornerRadius="14"
                            Background="{StaticResource Surface4}" BorderBrush="{StaticResource Faint}" BorderThickness="2">
                        <Panel Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="5,0">
                            <Ellipse Name="Knob" Fill="{StaticResource Faint}" />
                            <TextBlock Name="Tick" Classes="icon" Text="&#xF012C;" FontSize="14" Foreground="{StaticResource Accent}"
                                       HorizontalAlignment="Center" IsVisible="False" />
                        </Panel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{StaticResource OnAccent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Panel#Thumb">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ TextBlock#Tick">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Border#Track">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- ===== List rows ===== -->
    <Style Selector="Border.row">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="-10,0,-10,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>

    <!-- List boxes draw no chrome: rows style themselves. -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="18" Padding="14,10" Margin="0,0,0,3" Background="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource Hover}" />
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:selected /template/ Border#Bd">
        <Setter Property="Background" Value="{StaticResource SecondaryContainer}" />
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style Selector="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="Background" Value="{StaticResource Surface4}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource Surface3}" />
        <Setter Property="Foreground" Value="{StaticResource Text}" />
        <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</Styles>
