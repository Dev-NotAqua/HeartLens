                    <SolidColorBrush x:Key="Muted" Color="#615F4D" />
                    <SolidColorBrush x:Key="Faint" Color="#7F7A68" />
                    <SolidColorBrush x:Key="Accent" Color="#8A3B2E" />
                    <SolidColorBrush x:Key="AccentDeep" Color="#6F2D23" />
                    <SolidColorBrush x:Key="AccentSoft" Color="#148A3B2E" />
                    <SolidColorBrush x:Key="AccentLine" Color="#668A3B2E" />
                    <SolidColorBrush x:Key="AccentContainer" Color="#F0DED0" />
                    <SolidColorBrush x:Key="OnAccentContainer" Color="#5E2A20" />
