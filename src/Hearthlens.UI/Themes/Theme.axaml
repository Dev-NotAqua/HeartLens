                    <SolidColorBrush x:Key="Bg" Color="#101A16" />
                    <SolidColorBrush x:Key="Surface" Color="#17231E" />
                    <SolidColorBrush x:Key="Surface2" Color="#17231E" />
                    <SolidColorBrush x:Key="Surface3" Color="#1E2E27" />
                    <SolidColorBrush x:Key="Surface4" Color="#273A32" />
                    <SolidColorBrush x:Key="Border" Color="#2C3D35" />
