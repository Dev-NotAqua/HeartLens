                    <SolidColorBrush x:Key="Marigold" Color="#E2A63F" />
                    <SolidColorBrush x:Key="MarigoldSoft" Color="#26E2A63F" />
                    <SolidColorBrush x:Key="OnMarigold" Color="#151D18" />
                    <SolidColorBrush x:Key="Positive" Color="#7FBEA8" />
                    <SolidColorBrush x:Key="PositiveSoft" Color="#267FBEA8" />
                    <SolidColorBrush x:Key="Negative" Color="#D67B66" />
                    <SolidColorBrush x:Key="NegativeSoft" Color="#26D67B66" />
                    <SolidColorBrush x:Key="Info" Color="#8FB7C4" />
                    <SolidColorBrush x:Key="Hover" Color="#12EEE5D3" />
                    <SolidColorBrush x:Key="Pressed" Color="#1FEEE5D3" />
                    <SolidColorBrush x:Key="Decor" Color="#0C7FBEA8" />
                    <SolidColorBrush x:Key="DecorStrong" Color="#167FBEA8" />
                    <SolidColorBrush x:Key="OverlayPanel" Color="#F20F1A16" />
                    <SolidColorBrush x:Key="OverlayPanelSolid" Color="#FA15221D" />
                    <SolidColorBrush x:Key="OverlayBorder" Color="#66D67B66" />
                    <SolidColorBrush x:Key="ManaGem" Color="#3D7BE0" />
                    <SolidColorBrush x:Key="Row" Color="#1A2822" />
                    <SolidColorBrush x:Key="GoldTrim" Color="#4E5C54" />
                    <SolidColorBrush x:Key="GoldFill" Color="#D67B66" />
                    <SolidColorBrush x:Key="PanelEdge" Color="#2C3D35" />
                    <SolidColorBrush x:Key="SelectedEdge" Color="#53635A" />
                    <SolidColorBrush x:Key="SelectedFill" Color="#21362D" />
                    <LinearGradientBrush x:Key="PrimaryFill" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#E58D77" Offset="0" />
