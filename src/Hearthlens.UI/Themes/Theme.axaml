<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- ================= Printed edition ================= -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="BgColor">#EFE6D4</Color>
                    <Color x:Key="SurfaceColor">#F8F1E3</Color>
                    <Color x:Key="Surface2Color">#F8F1E3</Color>
                    <Color x:Key="Surface3Color">#E4D6BD</Color>
                    <Color x:Key="Surface4Color">#D9C7AA</Color>
                    <Color x:Key="BorderColor">#D8C8AE</Color>
                    <Color x:Key="OutlineColor">#B9A98F</Color>
                    <Color x:Key="TextColor">#1C1D17</Color>
                    <Color x:Key="MutedColor">#615F4D</Color>
                    <Color x:Key="FaintColor">#7F7A68</Color>

                    <Color x:Key="AccentColor">#8A3B2E</Color>
                    <Color x:Key="AccentDeepColor">#6F2D23</Color>
                    <Color x:Key="AccentContainerColor">#F0DED0</Color>
                    <Color x:Key="SecondaryContainerColor">#E1ECE5</Color>
                    <Color x:Key="PositiveColor">#2F6B5A</Color>
                    <Color x:Key="NegativeColor">#8A3B2E</Color>
                    <Color x:Key="InfoColor">#3E6B7A</Color>
                    <Color x:Key="MarigoldColor">#C8891F</Color>
                    <Color x:Key="NavColor">#173F35</Color>
                    <Color x:Key="NavActiveColor">#245746</Color>
                    <Color x:Key="NavTextColor">#F3EAD9</Color>
                    <Color x:Key="NavMutedColor">#B7C4B7</Color>

                    <Color x:Key="SystemAccentColor">#8A3B2E</Color>
                    <Color x:Key="SystemAccentColorDark1">#6F2D23</Color>
                    <Color x:Key="SystemAccentColorDark2">#57231B</Color>
                    <Color x:Key="SystemAccentColorDark3">#3A1712</Color>
                    <Color x:Key="SystemAccentColorLight1">#A54A39</Color>
                    <Color x:Key="SystemAccentColorLight2">#C06A57</Color>
                    <Color x:Key="SystemAccentColorLight3">#DDA08E</Color>

                    <SolidColorBrush x:Key="Bg" Color="#EFE6D4" />
                    <SolidColorBrush x:Key="Surface" Color="#F8F1E3" />
                    <SolidColorBrush x:Key="Surface2" Color="#F8F1E3" />
                    <SolidColorBrush x:Key="Surface3" Color="#E4D6BD" />
                    <SolidColorBrush x:Key="Surface4" Color="#D9C7AA" />
