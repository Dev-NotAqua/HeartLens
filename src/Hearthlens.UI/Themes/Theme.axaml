                        <GradientStop Color="#964333" Offset="0" />
                        <GradientStop Color="#7D3327" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="PrimaryFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#A54A39" Offset="0" />
                        <GradientStop Color="#8A3B2E" Offset="1" />
                    </LinearGradientBrush>

                    <SolidColorBrush x:Key="NavBg" Color="#173F35" />
                    <SolidColorBrush x:Key="NavActiveBg" Color="#245746" />
                    <SolidColorBrush x:Key="NavText" Color="#F3EAD9" />
                    <SolidColorBrush x:Key="NavMuted" Color="#B7C4B7" />
                    <SolidColorBrush x:Key="NavLine" Color="#28F3EAD9" />

                    <SolidColorBrush x:Key="RarityCommon" Color="#615F4D" />
                    <SolidColorBrush x:Key="RarityRare" Color="#2F6B5A" />
                    <SolidColorBrush x:Key="RarityEpic" Color="#6C4B7A" />
                    <SolidColorBrush x:Key="RarityLegendary" Color="#A56812" />

                    <SolidColorBrush x:Key="TierS" Color="#8A5E0E" />
                    <SolidColorBrush x:Key="TierA" Color="#2F6B5A" />
                    <SolidColorBrush x:Key="TierB" Color="#57756C" />
                    <SolidColorBrush x:Key="TierC" Color="#6B6654" />
                    <SolidColorBrush x:Key="TierD" Color="#8A3B2E" />

                    <LinearGradientBrush x:Key="TileFade" StartPoint="0%,0%" EndPoint="100%,0%">
                        <GradientStop Color="#FFF8F1E3" Offset="0" />
                        <GradientStop Color="#FFF8F1E3" Offset="0.42" />
                        <GradientStop Color="#66F8F1E3" Offset="0.8" />
                        <GradientStop Color="#14F8F1E3" Offset="1" />
                    </LinearGradientBrush>

                    <Color x:Key="ScrollBarPanningThumbBackgroundColor">#2E1C1D17</Color>
                    <Color x:Key="ScrollBarThumbBackgroundColor">#2E1C1D17</Color>
                    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#2E1C1D17" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#551C1D17" />
                    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#551C1D17" />
                    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#F8F1E3" Opacity="0.7" />
                    <SolidColorBrush x:Key="ScrollBarTrackFillPointerOver" Color="#F8F1E3" Opacity="0.9" />
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="#615F4D" />
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="#8A3B2E" />
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPressed" Color="#8A3B2E" />
                    <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundDisabled" Color="#7F7A68" />
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPointerOver" Color="#121C1D17" />
                    <SolidColorBrush x:Key="ScrollBarButtonBackgroundPressed" Color="#1F1C1D17" />
                    <SolidColorBrush x:Key="SliderTrackFill" Color="#D9C7AA" />
                    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#B9A98F" />
                    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#D9C7AA" />
                    <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#E4D6BD" />
                    <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="#7F7A68" />
                    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="#7F7A68" />
                </ResourceDictionary>

                <!-- ================= Night edition ================= -->
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="BgColor">#101A16</Color>
                    <Color x:Key="SurfaceColor">#17231E</Color>
                    <Color x:Key="Surface2Color">#17231E</Color>
