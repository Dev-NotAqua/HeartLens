                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ===== Type: Fraunces for display, Manrope for text, Material Design Icons ===== -->
            <FontFamily x:Key="UiFont">avares://Hearthlens.UI/Assets/Fonts#Manrope</FontFamily>
            <FontFamily x:Key="DisplayFont">avares://Hearthlens.UI/Assets/Fonts#Fraunces</FontFamily>
            <FontFamily x:Key="IconFont">avares://Hearthlens.UI/Assets/Fonts#Material Design Icons</FontFamily>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Text ===== -->
    <Style Selector="TextBlock.display">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="39" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="TextBlock.stat">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBlock.number">
        <Setter Property="FontFamily" Value="{DynamicResource DisplayFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="22,18" />
    </Style>
    <Style Selector="Border.overlayCard">
        <Setter Property="Background" Value="{DynamicResource OverlayPanel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OverlayBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BoxShadow" Value="0 2 14 0 #26000000" />
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="Background" Value="{DynamicResource Surface3}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="9,2" />
    </Style>
    <Style Selector="Border.segmentBar">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- ===== Buttons: ink and oxblood, with one marigold rule ===== -->
    <Style Selector="Button.ghost">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" />
                    <Border Name="State" Background="Transparent" CornerRadius="2" />
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border Name="Underline" Height="3" VerticalAlignment="Bottom" CornerRadius="0,0,2,2"
                            Background="{DynamicResource Marigold}" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ Border#State">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ Border#State">
        <Setter Property="Background" Value="{DynamicResource AccentContainer}" />
    </Style>
    <Style Selector="Button.ghost:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
        <Setter Property="Background" Value="{DynamicResource PrimaryFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="Button.primary /template/ Border#Underline">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource PrimaryFillHover}" />
        <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ Border#State">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ Border#State">
        <Setter Property="Background" Value="#22000000" />
    </Style>

    <!-- Small square icon buttons. -->
    <Style Selector="Button.icon">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontFamily" Value="{DynamicResource IconFont}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.icon:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource Surface4}" />
    </Style>
    <Style Selector="Button.icon:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource Pressed}" />
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- A button with no chrome: the content draws everything (overlay chips, rows). -->
    <Style Selector="Button.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===== Navigation: green spine, quiet rows, a marigold tick ===== -->
    <Style Selector="RadioButton.nav">
        <Setter Property="Foreground" Value="{DynamicResource NavMuted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="10,2" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Marigold}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <Border Name="Bd" CornerRadius="3" Margin="10,2" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                        <Panel>
                            <Border Name="Bar" Width="3" CornerRadius="1" Margin="0,8" HorizontalAlignment="Left"
                                    Background="{DynamicResource Marigold}" IsVisible="False" />
                            <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                                <TextBlock Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{DynamicResource IconFont}" FontSize="18"
                                           FontWeight="Normal" Width="24" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}" />
                                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Panel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource NavLine}" />
    </Style>
    <Style Selector="RadioButton.nav:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource NavText}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource NavActiveBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource NavLine}" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ Border#Bar">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ TextBlock#Glyph">
        <Setter Property="Foreground" Value="{DynamicResource Marigold}" />
    </Style>
    <Style Selector="RadioButton.nav:checked">
        <Setter Property="Foreground" Value="{DynamicResource NavText}" />
    </Style>

    <!-- ===== Chips / segmented filter ===== -->
    <Style Selector="RadioButton.segment">
        <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border CornerRadius="2" BorderThickness="1" BorderBrush="{DynamicResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="2" Padding="12,5" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Name="Check" Text="&#xF012C;" FontFamily="{DynamicResource IconFont}" FontSize="12" FontWeight="Normal"
                                   Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" IsVisible="False" />
                        <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.segment:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="RadioButton.segment:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="RadioButton.segment:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource Pressed}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource AccentContainer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentLine}" />
    </Style>
    <Style Selector="RadioButton.segment:checked /template/ TextBlock#Check">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.segment:checked">
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>

    <!-- ===== Switch (the track stays rounded: it is a toggle) ===== -->
    <Style Selector="CheckBox.switch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Border Name="Track" Grid.Column="1" Width="46" Height="26" CornerRadius="13"
                            Background="{DynamicResource Surface4}" BorderBrush="{DynamicResource Outline}" BorderThickness="1">
                        <Panel Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" Margin="5,0">
                            <Ellipse Name="Knob" Fill="{DynamicResource Faint}" />
                            <TextBlock Name="Tick" Text="&#xF012C;" FontFamily="{DynamicResource IconFont}" FontSize="13" FontWeight="Normal"
                                       Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="False" />
                        </Panel>
                    </Border>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Border#Track">
        <Setter Property="BorderBrush" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{DynamicResource Muted}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Border#Track">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Ellipse#Knob">
        <Setter Property="Fill" Value="{DynamicResource OnAccent}" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ Panel#Thumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="CheckBox.switch:checked /template/ TextBlock#Tick">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox.switch:pointerover /template/ Border#Track">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <!-- ===== List rows ===== -->
    <Style Selector="Border.row">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="-10,0,-10,2" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.row:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>

    <!-- List boxes draw no chrome: rows style themselves. -->
    <Style Selector="ListBox.plain">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.plain ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Padding="{TemplateBinding Padding}" Background="Transparent" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner">
            <FocusAdornerTemplate>
                <Border Margin="0,0,0,3" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource Accent}" />
            </FocusAdornerTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bd" CornerRadius="3" Padding="13,9" Margin="0,0,0,3" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter Name="Presenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:pointerover /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:pressed /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource Pressed}" />
    </Style>
    <Style Selector="ListBox.selectable ListBoxItem:selected /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource SelectedFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SelectedEdge}" />
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style Selector="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="Background" Value="{DynamicResource Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Outline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="320" />
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource Surface3}" />
        <Setter Property="Foreground" Value="{DynamicResource Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentDeep}" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
</Styles>
