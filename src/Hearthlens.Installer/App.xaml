<Application x:Class="Hearthlens.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Fraunces</FontFamily>
            <FontFamily x:Key="UiFont">pack://application:,,,/Assets/Fonts/#Manrope</FontFamily>
            <FontFamily x:Key="IconFont">pack://application:,,,/Assets/Fonts/#Material Design Icons</FontFamily>

            <!-- Colors: Hearthlens Palette -->
            <Color x:Key="PaperBgColor">#EFE6D4</Color>
            <Color x:Key="PaperCardColor">#F8F1E3</Color>
            <Color x:Key="PaperBorderColor">#D8C8AE</Color>
            <Color x:Key="SpineGreenColor">#173F35</Color>
            <Color x:Key="SpineDeepColor">#0F2A24</Color>
            <Color x:Key="InkTextColor">#1C1D17</Color>
            <Color x:Key="InkMutedColor">#615F4D</Color>
            <Color x:Key="InkFaintColor">#7F7A68</Color>
            <Color x:Key="OxbloodColor">#8A3B2E</Color>
            <Color x:Key="OxbloodHoverColor">#A54A39</Color>
            <Color x:Key="MarigoldColor">#C8891F</Color>
            <Color x:Key="VerdantColor">#2F6B5A</Color>
            <Color x:Key="VerdantLightColor">#7FBEA8</Color>

            <SolidColorBrush x:Key="PaperBg" Color="{StaticResource PaperBgColor}" />
            <SolidColorBrush x:Key="PaperCard" Color="{StaticResource PaperCardColor}" />
            <SolidColorBrush x:Key="PaperBorder" Color="{StaticResource PaperBorderColor}" />
            <SolidColorBrush x:Key="SpineGreen" Color="{StaticResource SpineGreenColor}" />
            <SolidColorBrush x:Key="SpineDeep" Color="{StaticResource SpineDeepColor}" />
            <SolidColorBrush x:Key="InkText" Color="{StaticResource InkTextColor}" />
            <SolidColorBrush x:Key="InkMuted" Color="{StaticResource InkMutedColor}" />
            <SolidColorBrush x:Key="InkFaint" Color="{StaticResource InkFaintColor}" />
            <SolidColorBrush x:Key="Oxblood" Color="{StaticResource OxbloodColor}" />
            <SolidColorBrush x:Key="OxbloodHover" Color="{StaticResource OxbloodHoverColor}" />
            <SolidColorBrush x:Key="Marigold" Color="{StaticResource MarigoldColor}" />
            <SolidColorBrush x:Key="Verdant" Color="{StaticResource VerdantColor}" />
            <SolidColorBrush x:Key="VerdantLight" Color="{StaticResource VerdantLightColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
