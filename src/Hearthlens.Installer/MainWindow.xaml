<Window x:Class="Hearthlens.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hearthlens Setup"
        Width="760" Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- Button styles matching Hearthlens -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Oxblood}" />
            <Setter Property="Foreground" Value="#F8F1E3" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="24,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource OxbloodHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#6F2D23" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#E4D6BD" />
            <Setter Property="Foreground" Value="{StaticResource InkText}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource PaperBorder}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D9C7AA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom CheckBox Style -->
        <Style x:Key="CardCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource InkText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Outer shadow container -->
    <Border Margin="12" CornerRadius="12" BorderThickness="1.5" BorderBrush="#0F2A24"
            Background="{StaticResource PaperBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- LEFT COLUMN: Spine (Bottle-Green themed with Logo & Steps)    -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0" CornerRadius="10,0,0,10" BorderThickness="0,0,1,0" BorderBrush="#0F2A24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0F2A24" Offset="0" />
                        <GradientStop Color="#173F35" Offset="0.5" />
                        <GradientStop Color="#0D2620" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid Margin="20,24,20,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- App Logo & Branding Header -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <Image Source="pack://application:,,,/Assets/hearthlens.png"
                               Width="76" Height="76" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Image.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000000" Opacity="0.5" />
                            </Image.Effect>
                        </Image>

                        <TextBlock Text="HEARTHLENS"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#F8F1E3"
                                   HorizontalAlignment="Center" />

                        <Border Background="#26C8891F" CornerRadius="10" Padding="8,2" Margin="0,6,0,0"
                                HorizontalAlignment="Center" BorderThickness="1" BorderBrush="#80C8891F">
                            <TextBlock Text="v0.12.2"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Marigold}" />
                        </Border>
                    </StackPanel>

                    <!-- Stepped Progress List -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="8,0">
                        <!-- Step 1: Welcome -->
                        <Grid Margin="0,8" x:Name="NavStep1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotStep1" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                    Background="{StaticResource Marigold}" VerticalAlignment="Center">
                                <TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="#101A16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep1" Grid.Column="1" Text="Welcome"
                                       Foreground="#F8F1E3" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Step 2: Preferences -->
                        <Grid Margin="0,8" x:Name="NavStep2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotStep2" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                    Background="#30FFFFFF" VerticalAlignment="Center">
                                <TextBlock Text="2" FontSize="10" FontWeight="Bold" Foreground="#A9A28F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep2" Grid.Column="1" Text="Preferences"
                                       Foreground="#A9A28F" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Step 3: Installing -->
                        <Grid Margin="0,8" x:Name="NavStep3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotStep3" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                    Background="#30FFFFFF" VerticalAlignment="Center">
                                <TextBlock Text="3" FontSize="10" FontWeight="Bold" Foreground="#A9A28F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep3" Grid.Column="1" Text="Installing"
                                       Foreground="#A9A28F" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>

                        <!-- Step 4: Finished -->
                        <Grid Margin="0,8" x:Name="NavStep4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="DotStep4" Grid.Column="0" Width="18" Height="18" CornerRadius="9"
                                    Background="#30FFFFFF" VerticalAlignment="Center">
                                <TextBlock Text="4" FontSize="10" FontWeight="Bold" Foreground="#A9A28F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="TxtStep4" Grid.Column="1" Text="Finished"
                                       Foreground="#A9A28F" FontSize="13" FontWeight="Medium"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Footer Note in Spine -->
                    <TextBlock Grid.Row="2" Text="Hearthstone Companion&#10;Win 10/11 x64"
                               FontSize="11" Foreground="#7F887C"
                               HorizontalAlignment="Center" TextAlignment="Center" LineHeight="16" />
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- RIGHT COLUMN: Main Content Area                               -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="1" CornerRadius="0,10,10,0" Background="{StaticResource PaperBg}">
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                <!-- Top Drag Bar & Window Controls -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- Minimize Button -->
                        <Button Click="BtnMinimize_Click" Width="30" Height="26"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="—" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource InkMuted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#20000000" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close Button -->
                        <Button Click="BtnClose_Click" Width="30" Height="26"
                                Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="4">
                                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource InkMuted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#208A3B2E" />
                                            <Setter TargetName="b" Property="TextBlock.Foreground" Value="{StaticResource Oxblood}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Dynamic Content Pages -->
                <Grid Grid.Row="1" Margin="32,8,32,24">

                    <!-- ──────────────────────────────────────────────────────── -->
                    <!-- PAGE 1: Welcome                                          -->
                    <!-- ──────────────────────────────────────────────────────── -->
                    <Grid x:Name="PageWelcome" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="A quieter Battlegrounds companion."
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource InkText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1"
                                   Text="In-game overlay, deck tracker, shop scores, trinket advisor, and real-time combat odds."
                                   FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,0,0,20" TextWrapping="Wrap" />

                        <!-- 3 Feature highlight cards -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Top">
                            <!-- Card 1 -->
                            <Border Background="{StaticResource PaperCard}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🛡️" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="100% Safe &amp; Non-Intrusive" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource InkText}" />
                                        <TextBlock Text="Only reads Hearthstone's log files and memory. Never modifies game data."
                                                   FontSize="12" Foreground="{StaticResource InkMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 2 -->
                            <Border Background="{StaticResource PaperCard}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔒" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Your Data Stays On Your PC" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource InkText}" />
                                        <TextBlock Text="Match history and settings stay in %APPDATA%\Hearthlens without online accounts."
                                                   FontSize="12" Foreground="{StaticResource InkMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Card 3 -->
                            <Border Background="{StaticResource PaperCard}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="14,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="⚡" FontSize="18" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Per-User Fast Setup" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{StaticResource InkText}" />
                                        <TextBlock Text="Installs cleanly into your user folder without administrator UAC prompts."
                                                   FontSize="12" Foreground="{StaticResource InkMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <TextBlock Text="Release: v0.12.2" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{StaticResource InkFaint}" />
                            <Button Content="Continue Setup →" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right" Click="BtnToPreferences_Click" />
                        </Grid>
                    </Grid>

                    <!-- ──────────────────────────────────────────────────────── -->
                    <!-- PAGE 2: Preferences                                      -->
                    <!-- ──────────────────────────────────────────────────────── -->
                    <Grid x:Name="PagePreferences" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Setup Preferences"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource InkText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1"
                                   Text="Select destination folder and desktop integration options."
                                   FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,0,0,18" />

                        <StackPanel Grid.Row="2">
                            <!-- Install Location Card -->
                            <TextBlock Text="INSTALLATION LOCATION" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource InkFaint}" Margin="0,0,0,6" />

                            <Border Background="{StaticResource PaperCard}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtInstallPath" Grid.Column="0"
                                             FontSize="12" VerticalAlignment="Center"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource InkText}" />
                                    <Button Grid.Column="1" Content="Browse..."
                                            Style="{StaticResource SecondaryBtn}"
                                            Padding="12,5" FontSize="11" Click="BtnBrowse_Click" />
                                </Grid>
                            </Border>

                            <TextBlock x:Name="TxtDiskSpace" Text="Space required: ~180 MB • Disk free: Checking..."
                                       FontSize="11" Foreground="{StaticResource InkMuted}" Margin="0,0,0,18" />

                            <!-- Shortcuts options -->
                            <TextBlock Text="INTEGRATION" FontSize="11" FontWeight="Bold"
                                       Foreground="{StaticResource InkFaint}" Margin="0,0,0,8" />

                            <Border Background="{StaticResource PaperCard}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="14,10">
                                <StackPanel>
                                    <CheckBox x:Name="ChkDesktop" Content="Create Desktop shortcut"
                                              IsChecked="True" Style="{StaticResource CardCheckBox}" Margin="0,0,0,10" />
                                    <CheckBox x:Name="ChkStartMenu" Content="Add to Windows Start Menu"
                                              IsChecked="True" Style="{StaticResource CardCheckBox}" Margin="0,0,0,10" />
                                    <CheckBox x:Name="ChkAutoStart" Content="Launch automatically when signing in to Windows"
                                              IsChecked="False" Style="{StaticResource CardCheckBox}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Actions -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Button Content="← Back" Style="{StaticResource SecondaryBtn}"
                                    HorizontalAlignment="Left" Click="BtnBackToWelcome_Click" />
                            <Button Content="Install Hearthlens v0.12.2" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right" Click="BtnStartInstall_Click" />
                        </Grid>
                    </Grid>

                    <!-- ──────────────────────────────────────────────────────── -->
                    <!-- PAGE 3: Installing                                       -->
                    <!-- ──────────────────────────────────────────────────────── -->
                    <Grid x:Name="PageInstalling" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Installing Hearthlens..."
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource InkText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1"
                                   Text="Extracting application files and configuring shortcuts."
                                   FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,0,0,32" />

                        <StackPanel Grid.Row="2" VerticalAlignment="Center">
                            <!-- Custom Progress Bar -->
                            <Border Background="#E4D6BD" Height="14" CornerRadius="7"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="2" Margin="0,0,0,12">
                                <Border x:Name="ProgressFill" Height="8" CornerRadius="4"
                                        HorizontalAlignment="Left" Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="{StaticResource VerdantColor}" Offset="0" />
                                            <GradientStop Color="{StaticResource VerdantLightColor}" Offset="0.8" />
                                            <GradientStop Color="{StaticResource MarigoldColor}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>

                            <Grid Margin="2,0">
                                <TextBlock x:Name="TxtStatus" Text="Extracting files..."
                                           FontSize="12" Foreground="{StaticResource InkMuted}"
                                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Width="380" />
                                <TextBlock x:Name="TxtPercent" Text="0%"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource Verdant}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ──────────────────────────────────────────────────────── -->
                    <!-- PAGE 4: Finished                                         -->
                    <!-- ──────────────────────────────────────────────────────── -->
                    <Grid x:Name="PageFinished" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource Verdant}" Margin="0,0,10,0">
                                <TextBlock Text="✓" Foreground="#F8F1E3" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Ready to Play!"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource InkText}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="Hearthlens 0.12.2 has been installed successfully."
                                   FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,0,0,20" />

                        <StackPanel Grid.Row="2">
                            <!-- Tips Card -->
                            <Border Background="{StaticResource PaperCard}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="GETTING STARTED" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource Marigold}" Margin="0,0,0,8" />

                                    <TextBlock Text="• First time running? Restart Hearthstone once after starting Hearthlens so that game logging is turned on."
                                               FontSize="12" Foreground="{StaticResource InkText}" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,8" />

                                    <TextBlock Text="• Overlay shortcuts: Ctrl+Shift+H toggles overlay visibility, Ctrl+Shift+L opens panel arrangement."
                                               FontSize="12" Foreground="{StaticResource InkText}" LineHeight="18" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="ChkLaunchNow" Content="Launch Hearthlens now"
                                      IsChecked="True" Style="{StaticResource CardCheckBox}" Margin="4,0,0,0" />
                        </StackPanel>

                        <!-- Actions -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Button Content="Exit" Style="{StaticResource SecondaryBtn}"
                                    HorizontalAlignment="Left" Click="BtnClose_Click" />
                            <Button Content="Finish &amp; Start Hearthlens" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right" Click="BtnFinish_Click" />
                        </Grid>
                    </Grid>

                    <!-- ──────────────────────────────────────────────────────── -->
                    <!-- PAGE 5: Uninstall Mode                                   -->
                    <!-- ──────────────────────────────────────────────────────── -->
                    <Grid x:Name="PageUninstall" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Uninstall Hearthlens"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource InkText}" Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1"
                                   Text="Remove Hearthlens 0.12.2 and its shortcuts from this PC."
                                   FontSize="13" Foreground="{StaticResource InkMuted}" Margin="0,0,0,20" />

                        <StackPanel Grid.Row="2">
                            <Border Background="{StaticResource PaperCard}" CornerRadius="8"
                                    BorderThickness="1" BorderBrush="{StaticResource PaperBorder}"
                                    Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="The app files, desktop shortcut, and Start menu shortcut will be removed."
                                               FontSize="12" Foreground="{StaticResource InkText}" LineHeight="18" TextWrapping="Wrap" Margin="0,0,0,10" />

                                    <CheckBox x:Name="ChkDeleteUserData"
                                              Content="Also delete my match history and settings (%APPDATA%\Hearthlens)"
                                              IsChecked="False" Style="{StaticResource CardCheckBox}" />
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtUninstallStatus" Text="" FontSize="12" Foreground="{StaticResource InkMuted}" />
                        </StackPanel>

                        <!-- Actions -->
                        <Grid Grid.Row="3" Margin="0,16,0,0">
                            <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                                    HorizontalAlignment="Left" Click="BtnClose_Click" />
                            <Button x:Name="BtnDoUninstall" Content="Uninstall Hearthlens" Style="{StaticResource PrimaryBtn}"
                                    HorizontalAlignment="Right" Click="BtnDoUninstall_Click" />
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Border>
</Window>
